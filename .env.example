APP_NAME="Disability Navigator API"
API_PREFIX="/api"

# PostgreSQL connection used by FastAPI, Alembic, and the demo seed command.
DATABASE_URL="postgresql+psycopg://xicom@localhost:5432/disability_navigator"
DATABASE_ECHO=false

# Hackathon defaults: start from an empty database without manual table creation.
DATABASE_STARTUP_CHECK=true
DATABASE_AUTO_CREATE=true
DATABASE_AUTO_SEED_DEMO=true

DEMO_AUTH_ENABLED=true
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
